# Application Configuration
APP_NAME="Shariah-Compliant AI Escrow Platform"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT=development

# API
API_V1_PREFIX=/api/v1

# Database - PostgreSQL
DATABASE_URL=postgresql+asyncpg://escrow_user:escrow_pass_2024@localhost:5437/escrow_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# Keycloak Configuration
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=escrow-platform
KEYCLOAK_CLIENT_ID=escrow-backend
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin123

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_AUDIENCE=escrow-backend
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# Security
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001"]

# Business Rules
DELIVERY_CONFIRMATION_WINDOW_HOURS=72
ESCROW_RELEASE_VALIDATION_HOURS=24
DISPUTE_RESOLUTION_DAYS=14
